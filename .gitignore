# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/

# PyInstaller (HapSync.exe build artifact; build/ and dist/ are already ignored above)
*.spec

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Decompiled APK (these can be large and contain Sony copyrighted code)
# Keep the recipe + analysis notes in research/, but never commit the raw output.
research/apk-decompile/
research/firmware-extracts/
*.apk
*.dex
*.so

# Firmware blobs (Sony copyright; never redistribute)
*.SonyAP
*.bin
*.img
*.tar.xz.sony
research/captures/*.pcap
research/captures/*.pcapng

# Local research scratch
research/notes/scratch-*
research/scratch/

# Personal hap_sync config (has your own folder paths / device) — keep the .example instead
tools/hap_sync.json
# hap_sync remote-index cache (local, machine-specific)
.hap_sync_cache/
# Generated transfer-plan dumps (one per share, overwritten each analysis)
tools/hap_plan_*.txt

# On-device library databases (user's personal library data; never commit)
*.db
research/db-schema/*.sql.bak

# Secrets / API keys (if we ever integrate Tidal/Qobuz dev keys)
.env
.env.*
*.key
*.pem
secrets/

# Generated docs
docs/_build/
site/

# Logs
*.log

# markdownlint leaves *.md.tmp.<pid>.<hash> files on disk after fixing — never commit those
*.md.tmp.*
*.tmp.*
