{
  // markdownlint-cli2 reads its rules and its ignores from this one file.
  "config": {
    "default": true,
    // Line length is not policed: prose is wrapped by hand, tables are wide.
    "MD013": false,
    "MD060": false
  },
  // Release notes are GitHub release bodies, not pages: they start with a
  // paragraph, not a heading.
  "ignores": [".github/release-notes/**", "node_modules/**"]
}
